-.meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
-.meta small { color: var(--dim); }
-.conn { padding: 3px 12px; border-radius: 999px; font-size: .85rem; border: 1px solid currentColor; }
+html { -webkit-text-size-adjust: 100%; }
+body {
+  margin: 0; color: var(--ink); font-family: var(--font); font-size: 15px; line-height: 1.45;
+  background: radial-gradient(1200px 600px at 85% -10%, #f9f9fa 0%, transparent 60%), var(--bg);
+  min-height: 100vh;
+}
+button { font-family: inherit; }
+:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: 2px; }
+
+/* ---------- shell ---------- */
+.app { max-width: 1180px; margin: 0 auto; padding: 22px 20px 150px; }
+.appbar { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
+.avatar { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800; letter-spacing: .02em;
+  background: linear-gradient(145deg, var(--accent-2), var(--accent)); box-shadow: 0 8px 18px rgba(217,59,10,.28); flex: none; }
+.hello { min-width: 0; }
+.hello b { display: block; font-size: 1.05rem; font-weight: 700; }
+.hello span { color: var(--muted); font-size: .9rem; }
+.appbar .grow { flex: 1; }
+.pill-sim { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: .68rem; font-weight: 800; letter-spacing: .09em; color: var(--warn); background: var(--warn-soft); }
+.conn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px; background: var(--card); box-shadow: var(--shadow-sm); font-size: .85rem; font-weight: 600; }
+.conn::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
 .conn.connected { color: var(--ok); } .conn.connecting { color: var(--warn); } .conn.disconnected { color: var(--bad); }
-.alert { background: #2a1517; border: 1px solid var(--bad); color: #ffb4b6; padding: 10px 14px; border-radius: 6px; }
-.empty { color: var(--dim); }
-.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; transition: opacity .3s; }
+.conn span { color: var(--ink-2); }
+.round-btn { position: relative; width: 52px; height: 52px; border-radius: 50%; border: 0; background: var(--card); box-shadow: var(--shadow-sm); color: var(--ink); display: grid; place-items: center; cursor: pointer; flex: none; }
+.round-btn:hover { box-shadow: var(--shadow); }
+.round-btn .count { position: absolute; top: 2px; right: 2px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--bad); color: #fff; font-size: .72rem; font-weight: 800; display: grid; place-items: center; border: 2px solid var(--bg); }
+.title { margin: 0 0 22px; font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.04; font-weight: 800; letter-spacing: -.025em; }
+.title em { font-style: normal; color: var(--accent); }
+
+/* chips */
+.chips { display: flex; gap: 10px; overflow-x: auto; padding: 4px 2px 10px; margin: 0 -2px 18px; scrollbar-width: none; }
+.chips::-webkit-scrollbar { display: none; }
+.chip { flex: none; border: 0; cursor: pointer; padding: 11px 20px; border-radius: 999px; background: var(--card); color: var(--ink); font-weight: 600; font-size: .95rem; box-shadow: var(--shadow-sm); }
+.chip:hover { box-shadow: var(--shadow); }
+.chip.on { background: var(--accent); color: #fff; box-shadow: 0 8px 18px rgba(217,59,10,.3); }
+
+/* floating dock (the dark pill with the orange active button) */
+.dock { position: fixed; left: 50%; bottom: max(18px, env(safe-area-inset-bottom)); transform: translateX(-50%); z-index: 60; display: flex; gap: 8px; padding: 9px; border-radius: 999px;
+  background: var(--dark); box-shadow: 0 18px 40px rgba(10,10,14,.35), 0 0 0 5px rgba(255,255,255,.55); }
+.dock button { display: flex; align-items: center; gap: 8px; height: 54px; min-width: 54px; justify-content: center; padding: 0 16px; border: 0; border-radius: 999px; background: var(--dark-2); color: #d6d8dc; cursor: pointer; font-weight: 700; font-size: .92rem; transition: background .2s, color .2s; }
+.dock button:hover { background: #3a3b3f; color: #fff; }
+.dock button.on { background: var(--accent); color: #fff; box-shadow: 0 6px 16px rgba(217,59,10,.5); }
+.dock button span { display: none; }
+.dock button.on span { display: inline; }
+
+/* ---------- generic pieces ---------- */
+.card { background: var(--card); border-radius: var(--r-lg); box-shadow: var(--shadow); }
+.btn { display: inline-flex; align-items: center; gap: 8px; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 10px 18px; font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; box-shadow: var(--shadow-sm); }
+.btn:hover:not(:disabled) { border-color: #c9ccd1; box-shadow: var(--shadow); }
