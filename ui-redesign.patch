 * { box-sizing: border-box; }
-body { margin: 0; background: var(--bg); color: var(--text); font-family: "Segoe UI", system-ui, sans-serif; }
-.page { max-width: 1100px; margin: 0 auto; padding: 24px 16px; }
-.top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 24px; }
-h1 { margin: 0 0 6px; font-size: 1.6rem; letter-spacing: .02em; }
