+  --bg: #eceef0; --bg-2: #f4f5f6; --card: #ffffff; --card-2: #f5f6f7;
+  --ink: #111214; --ink-2: #3a3d42; --muted: #666a71; --line: #e4e6e9;
+  --accent: #d93b0a; --accent-2: #ff7a4d; --accent-soft: #fde8e0;
+  --dark: #1b1c1e; --dark-2: #2c2d30;
+  --ok: #0f9d68; --ok-soft: #ddf4ea;
+  --warn: #b97800; --warn-fill: #f2a900; --warn-soft: #fff0cc;
+  --bad: #d6264a; --bad-soft: #fde1e7;
