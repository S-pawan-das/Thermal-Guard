+/* =====================================================================
+   THERMAL GUARD — design system
+   Light, soft and rounded: white cards on light grey, one orange accent,
+   big bold headings, pill chips, gauge dials and a floating dark dock.
+   Status colours (green / amber / crimson) are separate from the brand
+   orange, and every status also has a word and a symbol.
+   ===================================================================== */
 :root {
-  --bg: #0d1317; --panel: #151e24; --line: #243139; --text: #dce6ea; --dim: #8396a0;
