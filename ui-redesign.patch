@@ -0,0 +1,16 @@
+import { TEMPLATES } from "./templates";
+import { FACTORY_DEMO_SCENARIO, HALL_DEMO_SCENARIO } from "./demo";
+
+async function put(path: string, body: unknown) {
+  const res = await fetch(path, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error((data as { error?: string }).error || `HTTP ${res.status}`);
+}
+
+/** Replace the plant with a ready-made demo (zones, pipes, machines). Throws on failure. */
+export async function loadDemoPlant(key: "factory" | "hall"): Promise<void> {
+  const t = TEMPLATES.find((x) => x.key === key)!;
+  const b = t.build();
+  await put("/api/floorplan", { version: 2, zones: b.zones, exits: b.exits, links: b.links ?? [], background: null });
+  await put("/api/sim/scenario", key === "hall" ? HALL_DEMO_SCENARIO : FACTORY_DEMO_SCENARIO);
+}
