+.btn.on, .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 8px 18px rgba(217,59,10,.28); }
+.btn.danger { color: var(--bad); border-color: color-mix(in srgb, var(--bad) 45%, transparent); background: #fff; }
+.btn.dark { background: var(--dark); border-color: var(--dark); color: #fff; }
+.sep { width: 1px; height: 26px; background: var(--line); margin: 0 4px; }
+.hint { color: var(--muted); font-size: .86rem; margin: 8px 0; }
+.empty { color: var(--muted); }
+.alert { background: var(--bad-soft); color: #8d1230; padding: 12px 16px; border-radius: var(--r-sm); font-weight: 600; }
+.field-error { margin: 0 0 8px; font-size: .86rem; color: var(--bad); font-weight: 600; }
+.field-ok { margin: 0 0 8px; font-size: .86rem; color: var(--ok); font-weight: 600; }
+input, select { font-family: inherit; }
+.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
+.seg { display: inline-flex; padding: 4px; gap: 4px; border-radius: 999px; background: var(--card); box-shadow: var(--shadow-sm); }
+.seg .btn { border: 0; box-shadow: none; background: transparent; padding: 9px 18px; }
+.seg .btn.on { background: var(--accent); color: #fff; box-shadow: 0 6px 14px rgba(217,59,10,.3); }
+.heatview select, .simbox select, .details input, .limits-form input, .limits-form select {
+  padding: 10px 14px; background: var(--card-2); color: var(--ink); border: 1px solid transparent; border-radius: var(--r-sm); font: inherit; font-weight: 500; }
