+
+/* ---------- dashboard ---------- */
+.hero { border-radius: var(--r-lg); padding: 14px; margin-bottom: 22px; background: linear-gradient(135deg, #ff7a4d 0%, #f7a58a 55%, #fbd3c4 100%); box-shadow: var(--shadow); }
+.hero-in { background: var(--card); border-radius: 22px; padding: 20px 22px; display: grid; gap: 14px; grid-template-columns: 1fr auto; align-items: center; }
+.hero-in h2 { margin: 0 0 6px; font-size: 1.35rem; font-weight: 800; letter-spacing: -.01em; }
+.hero-in p { margin: 0; color: var(--muted); }
+.hero-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
+.tag { padding: 4px 12px; border-radius: 999px; font-size: .74rem; font-weight: 700; background: #e9e8ff; color: #4a43b8; }
+.tag.warm { background: #fdebd0; color: #8a5200; } .tag.good { background: var(--ok-soft); color: #0b6f48; } .tag.bad { background: var(--bad-soft); color: #9d1a38; }
+.kpis { display: flex; gap: 10px; }
+.kpi { min-width: 92px; padding: 12px 14px; border-radius: 18px; background: var(--card-2); text-align: left; }
+.kpi b { display: block; font-size: 1.7rem; font-weight: 800; line-height: 1; letter-spacing: -.02em; }
+.kpi span { font-size: .78rem; color: var(--muted); font-weight: 600; }
+.kpi.bad b { color: var(--bad); } .kpi.warn b { color: var(--warn); } .kpi.good b { color: var(--ok); }
+@media (max-width: 720px) { .hero-in { grid-template-columns: 1fr; } .kpis { flex-wrap: wrap; } .kpi { flex: 1; } }
