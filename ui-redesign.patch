+import { useEffect, useState } from "react";
+import type { MachineStatus, StateMessage } from "../../../shared/types";
+import { getJson, postJson, type ActionResult, type CauseReport } from "../twinApi";
+import { loadDemoPlant } from "../demoLoader";
+import Icon from "./icons";
+
+type Note = { kind: "ok" | "error"; text: string } | null;
+const VERDICT: Record<MachineStatus["verdict"], { label: string; cls: string; text: string }> = {
+  learning: { label: "Learning", cls: "", text: "Still learning what is normal for this machine." },
+  normal: { label: "Normal", cls: "good", text: "Heating up like it usually does." },
+  underperform: { label: "Weak", cls: "warn", text: "Heating LESS than usual. It may need repair, or it is working less efficiently." },
+  overshoot: { label: "Too hot", cls: "bad", text: "Heating MORE than usual. Watch it closely and stop it if this continues." },
+};
+
+function CycleChart({ m }: { m: MachineStatus }) {
+  const W = 320, H = 120, L = 28, B = 18, T = 8, R = 8;
+  const maxY = Math.max(1, ...m.curve.map((c) => c.mean + c.sd), ...m.actual.map((a) => a.v)) * 1.1;
+  const x = (min: number) => L + (min / m.window) * (W - L - R);
+  const y = (v: number) => T + (1 - Math.max(0, v) / maxY) * (H - T - B);
+  const band = m.curve.length
+    ? m.curve.map((c, i) => `${i ? "L" : "M"}${x(c.m)},${y(c.mean + c.sd)}`).join("") + [...m.curve].reverse().map((c) => `L${x(c.m)},${y(c.mean - c.sd)}`).join("") + "Z"
+    : "";
+  const act = m.actual.map((a, i) => `${i ? "L" : "M"}${x(a.m)},${y(a.v)}`).join("");
+  const colour = m.verdict === "overshoot" ? "#d6264a" : m.verdict === "underperform" ? "#d98f00" : "#0f9d68";
+  return (
+    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${m.name}: today against normal`} className="cycle-chart">
+      <line x1={L} y1={H - B} x2={W - R} y2={H - B} stroke="#d5d8dc" />
+      {band && <path d={band} fill="#9aa3ad" opacity=".28" />}
+      {act && <path d={act} fill="none" stroke={colour} strokeWidth="3" strokeLinecap="round" />}
+      <text x={L} y={H - 4} fontSize="9" fill="#666a71">start</text>
+      <text x={W - R} y={H - 4} fontSize="9" textAnchor="end" fill="#666a71">{m.window} min</text>
+    </svg>
+  );
+}
+
+export default function Insights({ state }: { state: StateMessage | null }) {
+  const [actions, setActions] = useState<ActionResult[]>([]);
+  const [causes, setCauses] = useState<CauseReport | null>(null);
+  const [note, setNote] = useState<Note>(null);
+  const [busy, setBusy] = useState(false);
+  const zones = state?.zones ?? [];
+  const machines = state?.machines ?? [];
+  const links = state?.links ?? [];
+  const zoneName = (id?: string) => zones.find((z) => z.id === id)?.name ?? id ?? "";
+
+  useEffect(() => {
+    let dead = false;
+    const pull = () => getJson<{ results: ActionResult[] }>("/api/twin/actions?minutes=60").then((r) => { if (!dead) setActions(r.results); }, () => undefined);
+    pull();
+    const t = setInterval(pull, 5000);
+    return () => { dead = true; clearInterval(t); };
+  }, []);
+
+  const worst = zones.find((z) => z.status === "critical") ?? zones.find((z) => z.status !== "normal");
+  const problems = machines.filter((m) => m.verdict === "underperform" || m.verdict === "overshoot");
+  const spreading = links.filter((l) => l.danger === "spread");
+  const focus = worst?.id ?? "";
+  useEffect(() => {
+    if (!focus) { setCauses(null); return; }
+    let dead = false;
+    const pull = () => getJson<CauseReport>(`/api/twin/causes?zoneId=${encodeURIComponent(focus)}&minutes=60`).then((r) => { if (!dead) setCauses(r); }, () => { if (!dead) setCauses(null); });
+    pull();
+    const t = setInterval(pull, 5000);
+    return () => { dead = true; clearInterval(t); };
+  }, [focus]);
+
+  async function run(label: string, ...calls: Array<() => Promise<{ ok: true; message: string } | { ok: false; error: string }>>) {
+    setBusy(true);
+    setNote(null);
+    for (const c of calls) {
+      const r = await c();
+      if (!r.ok) { setNote({ kind: "error", text: r.error }); setBusy(false); return; }
+    }
+    setNote({ kind: "ok", text: label });
+    setBusy(false);
+  }
+  async function startDemo(key: "factory" | "hall") {
+    setBusy(true);
+    try { await loadDemoPlant(key); setNote({ kind: "ok", text: "Demo started. Now try the buttons below." }); } catch (e) { setNote({ kind: "error", text: (e as Error).message }); }
+    setBusy(false);
+  }
+
+  if (state && (zones.length === 0 || machines.length === 0))
+    return (
+      <section className="insights">
+        <div className="card ins-card start-card">
+          <h2>Start here</h2>
+          <p>Load a ready-made factory. It has rooms, pipes between them and machines that heat up. Then you can break things and watch Thermal Guard react.</p>
+          <div className="toolbar">
+            <button className="btn primary big" disabled={busy} onClick={() => startDemo("factory")}>Start the factory demo</button>
+            <button className="btn big" disabled={busy} onClick={() => startDemo("hall")}>Start the open-hall demo</button>
+          </div>
+          {note && <p className={note.kind === "ok" ? "field-ok" : "field-error"}>{note.text}</p>}
+        </div>
+      </section>
+    );
+
+  const first = actions.find((a) => !/little difference/i.test(a.bought));
+  const fireZone = links[0]?.a ?? zones[0]?.id;
+  const weak = machines.find((m) => m.id.includes("paint-1")) ?? machines[0];
+  const status = problems.length || spreading.length || worst ? (worst?.status === "critical" || problems.some((p) => p.verdict === "overshoot") || spreading.length ? "bad" : "warn") : "good";
+  const headline =
+    status === "good" ? "Everything is fine"
+    : problems.length ? `${problems[0].name} is ${problems[0].verdict === "overshoot" ? "heating too much" : "not heating enough"}`
+    : spreading.length ? "Heat could spread to connected rooms"
+    : `${worst!.name} is ${worst!.status === "critical" ? "out of its safe range" : "getting close to its limit"}`;
+
+  return (
+    <section className="insights">
+      <div className={`card ins-card status-card ${status}`} role="status">
+        <span className="status-dot"><Icon name={status === "good" ? "check" : "alert"} size={26} /></span>
+        <div>
+          <h2>{headline}</h2>
+          <p>
+            {status === "good" ? "No machine or room is behaving strangely and nothing is predicted to go out of range in the next hour."
+              : problems.length ? VERDICT[problems[0].verdict].text
+              : spreading.length ? `Connected: ${spreading.map((l) => `${zoneName(l.a)} ↔ ${zoneName(l.b)}`).join(", ")}.`
+              : causes?.summary ?? "Predicted to leave its safe range soon."}
+          </p>
+        </div>
+      </div>
+
+      {status !== "good" && first && (
+        <div className="card ins-card do-card">
+          <div>
+            <small>BEST NEXT STEP</small>
+            <h3>{first.label}</h3>
+            <p>{first.bought}</p>
+          </div>
+          <button className="btn primary big" disabled={busy} onClick={() => run("Done. Watch the status change.", () => postJson("/api/twin/apply", first.action))}>Do it</button>
+        </div>
+      )}
+
+      <div className="card ins-card">
+        <h2>Try it: break something</h2>
+        <p className="hint">Each button creates a problem. Thermal Guard spots it, tells you why and what to do.</p>
+        <div className="try-grid">
+          <button disabled={busy} onClick={() => run("A weak machine is running.", () => postJson("/api/sim/start-day", { machineId: weak?.id, mode: "weak" }), () => postJson("/api/sim/fast-forward", { minutes: 15 }))}>
+            <b>A machine gets weak</b><span>Heats less than usual</span>
+          </button>
+          <button disabled={busy} onClick={() => run("An overheating machine is running.", () => postJson("/api/sim/start-day", { machineId: machines[machines.length - 1]?.id, mode: "overheat" }), () => postJson("/api/sim/fast-forward", { minutes: 15 }))}>
+            <b>A machine overheats</b><span>Heats more than usual</span>
+          </button>
+          <button disabled={busy || !fireZone} onClick={() => run(`Fire started in ${zoneName(fireZone)}. Connected rooms are now at risk.`, () => postJson("/api/sim/fire", { zoneId: fireZone }))}>
+            <b>Fire in one room</b><span>See which rooms are at risk</span>
+          </button>
+          <button disabled={busy} onClick={() => run("Back to a normal day.", () => postJson("/api/sim/reset", {}), () => postJson("/api/sim/start-day", { mode: "normal" }), () => postJson("/api/sim/fast-forward", { minutes: 10 }))}>
+            <b>Back to normal</b><span>Reset everything</span>
+          </button>
+        </div>
+        {note && <p className={note.kind === "ok" ? "field-ok" : "field-error"} role="status">{note.kind === "ok" ? "✔ " : "✖ "}{note.text}</p>}
+      </div>
+
+      <div className="card ins-card">
+        <h2>Your machines</h2>
+        <p className="hint">Grey band = how this machine normally warms up. The line is today.</p>
+        <div className="mach-grid">
+          {[...machines].sort((a, b) => Number(b.verdict === "overshoot" || b.verdict === "underperform") - Number(a.verdict === "overshoot" || a.verdict === "underperform")).map((m) => {
+            const v = VERDICT[m.verdict];
+            return (
+              <article key={m.id} className={`mach ${v.cls}`}>
+                <header><b>{m.name}</b><span className={`chip-note ${v.cls}`}>{v.label}</span></header>
+                <small>{zoneName(m.zoneId) || "open floor"}</small>
+                {(m.curve.length > 0 || m.actual.length > 0) && <CycleChart m={m} />}
+                <p className="mach-text">{v.text}</p>
+              </article>
+            );
+          })}
+        </div>
+      </div>
+
+      <details className="card ins-card more">
+        <summary>More details (for the curious)</summary>
+        {causes && <><h3>Why is {causes.zoneName} heating?</h3><p className="why-summary">{causes.summary}</p>
+          <ul className="cause-list">{causes.causes.map((c) => <li key={c.kind + c.id}><div className="cause-top"><b>{c.label}</b><span>{c.sharePct}%</span></div><div className="cause-bar"><i style={{ width: `${Math.min(100, c.sharePct)}%` }} /></div></li>)}</ul></>}
+        {actions.length > 1 && <><h3>Other options</h3><ul className="act-list">{actions.filter((a) => a !== first).slice(0, 4).map((a) => <li key={a.key}><div><b>{a.label}</b><p>{a.bought}</p></div><button className="btn" disabled={busy} onClick={() => run("Done.", () => postJson("/api/twin/apply", a.action))}>Do it</button></li>)}</ul></>}
+        {links.length > 0 && <><h3>Pipes and connections</h3><ul className="act-list">{links.map((l) => <li key={l.id}><div><b>{zoneName(l.a)} ↔ {zoneName(l.b)}</b><p>{l.kind}{l.closed ? " · closed" : ""}</p></div><button className="btn" disabled={busy} onClick={() => run(l.closed ? "Reopened." : "Closed: no heat travels through it.", () => postJson("/api/sim/link", { linkId: l.id, closed: !l.closed }))}>{l.closed ? "Reopen" : "Close it"}</button></li>)}</ul></>}
+        <p className="hint">Machine patterns are learned from simulated earlier days. Predictions run the same simulator forward on a copy.</p>
+      </details>
+    </section>
+  );
+}
