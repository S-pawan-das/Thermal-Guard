# Copy to server/.env (never commit .env)
PORT=3001
# Only this origin may call the API directly from a browser.
CLIENT_ORIGIN=http://localhost:5173
# Where floorplan.json is stored (relative to the server folder)
DATA_DIR=data
# Simulation speed: steps per update x updates per second (see README)
SIM_INTERVAL_MS=1000
SIM_STEPS_PER_TICK=1
# Alerts: hysteresis (deg C an alert must recover by) and cooldown (ms in which a recovered alert is re-opened, not duplicated)
ALERT_HYSTERESIS_C=0.3
ALERT_COOLDOWN_MS=60000
